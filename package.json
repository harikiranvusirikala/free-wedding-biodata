{
  "name": "free-wedding-biodata",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node --import tsx scripts/sw-build.mts",
    "serve": "node --import tsx scripts/serve-out.mts",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fonts": "node --import tsx scripts/fonts.mts",
    "images": "node --import tsx scripts/site-images.mts"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "harfbuzzjs": "^1.6.4",
    "next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "@expo-google-fonts/noto-sans-bengali": "^0.4.4",
    "@expo-google-fonts/noto-sans-devanagari": "^0.4.2",
    "@expo-google-fonts/noto-sans-gujarati": "^0.4.2",
    "@expo-google-fonts/noto-sans-gurmukhi": "^0.4.1",
    "@expo-google-fonts/noto-sans-kannada": "^0.4.3",
    "@expo-google-fonts/noto-sans-malayalam": "^0.4.2",
    "@expo-google-fonts/noto-sans-tamil": "^0.4.3",
    "@expo-google-fonts/noto-sans-telugu": "^0.4.2",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
